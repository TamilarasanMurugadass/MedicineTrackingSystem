# Environment Variables Template for Render Deployment
# DO NOT commit actual values to repository

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Database Connection
# Replace with your actual MySQL connection string
ConnectionStrings__DefaultConnection=Server=your-host;Port=3306;Database=your-db;User=your-user;Password=your-password;Convert Zero Datetime=True;

# JWT Configuration
# Generate a strong secret key using: openssl rand -base64 64
JWT__SecretKey=your-super-secret-key-at-least-32-characters-long
JWT__Issuer=MedicineTrackingAPI
JWT__Audience=MedicineTrackingClient

# CORS Configuration
# Add your frontend URLs
CORS__AllowedOrigins__0=https://your-frontend-domain.com
CORS__AllowedOrigins__1=https://www.your-frontend-domain.com

# Optional: Logging Level
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
